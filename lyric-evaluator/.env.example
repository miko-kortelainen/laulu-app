# Copy to .env inside this folder. No main-app configuration is loaded.
PORT=3002
LYRIC_EVAL_MODEL=gemini-4-argon
LYRIC_EVAL_PROJECT=lyric-quality-evaluator

# Direct Gemini API authentication. Keep this key on the server.
GEMINI_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set this only if your LangSmith key requires a workspace ID.
LANGSMITH_WORKSPACE_ID=
