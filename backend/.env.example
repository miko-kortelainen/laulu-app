# Nebius Token Factory Configuration
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
LYRICS_MODEL=zai-org/GLM-5.3-Flash

# Lyria 3.5 music generation (requires Gemini API billing)
GEMINI_API_KEY=your_gemini_api_key_here

# QwenCloud audio analysis (paid inference, independent of Nebius and Google)
DASHSCOPE_API_KEY=your_qwencloud_api_key_here

# Cloudflare AI Gateway BYOK (optional; set all three to route every hosted AI call)
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=
# Custom provider slugs without the custom- prefix; use root-domain upstream URLs.
CF_AI_GATEWAY_NEBIUS_SLUG=nebius
CF_AI_GATEWAY_QWENCLOUD_SLUG=qwencloud

# LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=musical-copilot

# Server port
PORT=3001
