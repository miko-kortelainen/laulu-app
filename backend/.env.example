# Models
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
LYRICS_MODEL=zai-org/GLM-5.3-Flash

# Cloudflare AI Gateway BYOK (required for every hosted AI call)
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=
# Custom provider slugs without the custom- prefix; use root-domain upstream URLs.
CF_AI_GATEWAY_NEBIUS_SLUG=nebius
CF_AI_GATEWAY_QWENCLOUD_SLUG=qwencloud

# LangSmith observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=musical-copilot

# Server port
PORT=3001
# Supabase Auth: use the same project and publishable key as the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Generated songs: server-only database writes and private Cloudflare R2 objects.
SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Defaults for new users. Existing allowances live in public.user_quotas.
QUOTA_CHAT_DAILY=20
QUOTA_ANALYSIS_DAILY=10
QUOTA_GENERATION_DAILY=5
QUOTA_STORAGE_BYTES=536870912
# Shared UTC daily attempt limits across all users. Set positive values to enable paid operations.
GLOBAL_CHAT_DAILY=200
GLOBAL_ANALYSIS_DAILY=30
GLOBAL_GENERATION_DAILY=20
# Reserve this much space before generation. Larger tracks remain in local recovery.
MAX_GENERATED_SONG_BYTES=26214400
