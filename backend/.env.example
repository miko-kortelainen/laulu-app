# Models
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
LYRICS_MODEL=Qwen/Qwen3.8-27B

# Cloudflare AI Gateway BYOK (required for every hosted AI call)
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=
# Custom provider slugs without the custom- prefix; use root-domain upstream URLs.
CF_AI_GATEWAY_NEBIUS_SLUG=nebius
CF_AI_GATEWAY_QWENCLOUD_SLUG=qwencloud

# LangSmith observability (always disabled in the production beta with NODE_ENV=production)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=musical-copilot

# Server port
PORT=3001
# Supabase Auth: use the same project and publishable key as the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Generated songs: server-only database writes and private Cloudflare R2 objects.
SUPABASE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Paddle sandbox only. API key and notification signing secret are different credentials.
# API permissions: price.read, transaction.read/write.
PADDLE_SANDBOX_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=pri_01m4tvkjam9nptz0f1ngrbr9mj
PADDLE_PRO_PRICE_ID=pri_01m4tvmm85j15s4vjd9ykmsa0d
PADDLE_ULTRA_PRICE_ID=pri_01m4tvnr6xfnyk1nwtyt5vma9e

# Plan allowances are configured in Supabase public.plan_limits.
# Shared UTC daily attempt limits across all users. Set positive values to enable paid operations.
GLOBAL_CHAT_DAILY=200
GLOBAL_ANALYSIS_DAILY=30
GLOBAL_GENERATION_DAILY=20
# Reserve this much space before generation. Larger tracks remain in local recovery.
MAX_GENERATED_SONG_BYTES=26214400

# Browser origins allowed to read API responses from another origin. Same-origin requests need no entry.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum simultaneous uploads and audio conversions on this server.
MAX_AUDIO_JOBS=2
