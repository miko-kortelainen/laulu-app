{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for chatbot using Strands Agents SDK and Nebius Token Factory",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:music": "tsx --test tests/music.test.ts",
    "test:lyrics": "node --import tsx tests/lyrics.test.ts",
    "test:analysis": "node --import tsx tests/analysis.test.ts",
    "test:stems": "tsx --test tests/stems.test.ts",
    "test:tracing": "node --import tsx tests/tracing.test.ts",
    "test:auth": "node --import tsx --test tests/auth.test.ts",
    "test:songs": "node --import tsx --test tests/songs.test.ts",
    "test:quotas:db": "node --test tests/quotas-db.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@google/genai": "^2.26.0",
    "@strands-agents/sdk": "^1.19.0",
    "@supabase/supabase-js": "2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "langsmith": "^0.10.6",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
