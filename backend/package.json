{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for chatbot using Strands Agents SDK and Nebius Token Factory",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:music": "tsx --test tests/music.test.ts",
    "test:tracing": "node --import tsx tests/tracing.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "langsmith": "^0.10.6",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
