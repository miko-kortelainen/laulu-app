VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Public Turnstile site key. Enable matching CAPTCHA enforcement in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Public sandbox client token and monthly/yearly price IDs from Paddle. Never use the API key here.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_STARTER_PRICE_ID=
VITE_PADDLE_PRO_PRICE_ID=
VITE_PADDLE_ULTRA_PRICE_ID=

VITE_PADDLE_STARTER_ANNUAL_PRICE_ID=pri_01m50px1szmdvk7ytv5sejdzgr
VITE_PADDLE_PRO_ANNUAL_PRICE_ID=pri_01m50pzdw9pfn9c5ss1kehnv9n
VITE_PADDLE_ULTRA_ANNUAL_PRICE_ID=pri_01m50q3rnc8na58rv1s4n9yay9
# Public Sentry frontend DSN. Leave empty to disable monitoring locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Use the deployed Git commit, matching SENTRY_RELEASE.
VITE_SENTRY_RELEASE=
